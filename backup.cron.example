# User crontab (crontab -e), not /etc/cron.d. Adjust /opt/greg-infra.
# Runs at 00:00, 06:00, 12:00 and 18:00 in the server's local timezone.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0 0,6,12,18 * * * /bin/bash /opt/greg-infra/backup.sh >> /opt/greg-infra/backup.log 2>&1
